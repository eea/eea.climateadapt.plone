<h1>Import Extended Tool categories</h1>

<p>
  Upload the <code>Navigator_tool_icon_assignment.ods</code> file. The importer
  matches existing Extended Tools by Tool ID and changes only their
  <code>tool_type</code> field.
</p>

<p>
  <strong>Target folder:</strong>
  <code tal:content="view/target_path">/cca/en/metadata/tools</code>
</p>

<form action="./@@import-tool-types" method="post" enctype="multipart/form-data">
  <p>
    <label for="assignment_file">Assignment file (ODS):</label><br />
    <input
      type="file"
      name="assignment_file"
      id="assignment_file"
      accept=".ods,application/vnd.oasis.opendocument.spreadsheet"
      required="required"
    />
  </p>
  <p>
    <label>
      <input type="checkbox" name="commit" value="1" />
      Commit changes (leave unchecked for a dry-run preview)
    </label>
  </p>
  <input type="submit" value="Process assignments" />
</form>

<tal:results define="items view/list">
  <div class="portalMessage error" tal:condition="view/error">
    <strong>Import failed:</strong>
    <span tal:content="view/error"></span>
  </div>

  <div tal:condition="items">
    <div class="portalMessage info" tal:condition="python:not view.committed">
      Dry-run only: no content was changed.
    </div>
    <div class="portalMessage info" tal:condition="view/committed">
      The assignments were committed.
    </div>

    <h2>
      Results (<span tal:replace="python:len(items)">0</span> tools processed)
    </h2>
    <table border="1" cellpadding="5" cellspacing="0">
      <thead>
        <tr>
          <th>Status</th>
          <th>Tool ID</th>
          <th>Tool</th>
          <th>Tool type</th>
        </tr>
      </thead>
      <tbody>
        <tr tal:repeat="item items">
          <td tal:content="item/status"></td>
          <td tal:content="item/external_id"></td>
          <td>
            <a
              tal:condition="item/url"
              tal:attributes="href item/url"
              tal:content="python:item.get('actual_name', item['name'])"
              target="_blank"
            ></a>
            <span
              tal:condition="python:not item.get('url')"
              tal:content="item/name"
            ></span>
          </td>
          <td tal:content="item/category"></td>
        </tr>
      </tbody>
    </table>
  </div>
</tal:results>
