<tal:block tal:define="results view/list">
<form method="get">
    <label>Path (/cca/en/...):</label>
    <input type="text"
           name="path"
           tal:attributes="value results/path" />

    <label>Portal Type:</label>
    <select name="portal_type">
        <option value="-Select-" tal:attributes="selected python:results['portalType'] == '-Select-' or not results['portalType']">-Select-</option>
        <option tal:repeat="pt results/all_portal_types"
                tal:attributes="value pt; selected python:pt == results['portalType']"
                tal:content="pt">
        </option>
    </select>

    <input type="submit" value="Search" />
</form>
<hr>

<tal:block tal:condition="python:results['portalType'] and results['portalType'] != '-Select-'">
<h2>Stats for: <span tal:content="results/portalType">Portal Type</span> in <span tal:content="results/mainPathSearch">Path</span></h2>
<table class="listing">
  <thead>
    <tr>
      <th>Folder Path</th>
      <th>Total</th>
      <th>States</th>
    </tr>
  </thead>
  <tbody>
    <tr tal:repeat="item results/data">
      <td tal:content="item/path">Path</td>
      <td tal:content="item/count">23</td>
      <td>
        <ul>
          <li tal:repeat="state item/states/items">
            <span tal:content="python:state[0]">published</span>:
            <span tal:content="python:state[1]">18</span>
          </li>
        </ul>
      </td>
    </tr>
  </tbody>
</table>
</tal:block>

<tal:block tal:condition="python:not results['portalType'] or results['portalType'] == '-Select-'">
<h2>Please select a valid portal type to search.</h2>
</tal:block>

</tal:block>