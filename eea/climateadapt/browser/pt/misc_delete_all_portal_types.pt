<tal:block tal:define="results view/list">
<script>
function confirmDelete(form) {
    var pt = form.portal_type.value;
    if (pt === '-Select-') {
        alert("Please select a portal type.");
        return false;
    }
    var path = form.path.value;
    var folder = path ? path : "the root folder";
    return confirm('Are you sure you want to delete all items with portal type ' + pt + ' from folder ' + folder + '?');
}
</script>
<form method="post" onsubmit="return confirmDelete(this);">
    <label>Path (/cca/en/...):</label>
    <input type="text"
           name="path"
           tal:attributes="value results/path" />

    <label>Portal Type:</label>
    <select name="portal_type">
        <option value="-Select-" tal:attributes="selected python:results['portalType'] == '-Select-' or not results['portalType']">-Select-</option>
        <option tal:repeat="pt results/all_portal_types"
                tal:attributes="value pt; selected python:pt == results['portalType']"
                tal:content="pt">
        </option>
    </select>

    <input type="hidden" name="confirm" value="yes" />
    <input type="submit" value="Delete All" />
</form>
<hr>

<tal:block tal:condition="python:results['confirmed'] and results['portalType'] and results['portalType'] != '-Select-'">
<h2>Deleted <span tal:content="results/deleted_count">0</span> items for <span tal:content="results/portalType">Portal Type</span> in <span tal:content="results/mainPathSearch">Path</span></h2>
<table class="listing">
  <thead>
    <tr>
      <th>Deleted Folder Path</th>
    </tr>
  </thead>
  <tbody>
    <tr tal:repeat="item results/data">
      <td tal:content="item">Path</td>
    </tr>
  </tbody>
</table>
</tal:block>

<tal:block tal:condition="python:not results['confirmed']">
<h2>Please select a portal type and path to delete.</h2>
</tal:block>

</tal:block>
